// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. Enums (ค่าคงที่ระบบอื่นๆ ยังคงเดิม)
// ==========================================


enum LeaveDuration {
  Full
  HalfMorning
  HalfAfternoon
}

enum RequestStatus {
  Pending
  Approved
  Rejected
  Cancelled
  Withdraw_Pending
}

enum NotificationType {
  NewRequest
  Approval
  Rejection
  LateWarning
  EarlyLeaveWarning
  CheckIn
  CheckOut
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  WITHDRAW
  SYSTEM_LOCK
  LOGIN
}

enum CheckInStatus {
  ON_TIME
  LATE
  LEAVE
  ABSENT
}

enum CheckOutStatus {
  NORMAL
  EARLY
  LEAVE
  NO_CHECKOUT
}

// ==========================================
// 2. Organization Structure
// ==========================================

// ✅ NEW: Role Model (Dynamic Role)
model Role {
  id          Int      @id @default(autoincrement()) @map("role_id")
  name        String   @unique @db.VarChar(50) // e.g., "HR", "WORKER", "ADMIN"
  description String?  @db.Text
  permissions Json?    @map("permissions") // เก็บ config สิทธิ์ (Optional)

  employees   Employee[]
  workConfig  WorkConfiguration? // 1 Role มี 1 การตั้งค่าเวลา

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ✅ Model Department (Dynamic Department)
model Department {
  id          Int      @id @default(autoincrement()) @map("department_id")
  name        String   @unique @db.VarChar(100) 
  description String?  @db.Text
  
  employees   Employee[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Employee {
  id              Int       @id @default(autoincrement()) @map("employee_id")
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  
  // ✅ UPDATED: Link to Role Model
  roleId          Int       @map("role_id")
  role            Role      @relation(fields: [roleId], references: [id])
  
  // ✅ UPDATED: Link to Department Model
  departmentId    Int?      @map("department_id")
  department      Department? @relation(fields: [departmentId], references: [id])
  
  joiningDate     DateTime  @map("joining_date") @db.Date
  resignationDate DateTime? @map("resignation_date") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  profileImageUrl String?   @map("profile_image_url") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relations
  leaveQuotas             LeaveQuota[]
  timeRecords             TimeRecord[]
  leaveRequestsAsEmployee LeaveRequest[] @relation("EmployeeRequests")
  leaveRequestsAsHr       LeaveRequest[] @relation("HrApprovals")
  notifications           Notification[] @relation("NotificationOwner")
  relatedNotifications    Notification[] @relation("NotificationRelatedEmployee")
  specialLeaveGrants      SpecialLeaveGrant[]
  auditLogsPerformedBy    AuditLog[]     @relation("AuditLogsPerformedBy")

  @@map("employees")
}

// ==========================================
// 3. Configuration
// ==========================================

model WorkConfiguration {
  id        Int      @id @default(autoincrement())
  
  // ✅ UPDATED: Link to Role Model instead of Enum
  roleId    Int      @unique @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  
  // Work Hours
  startHour Int
  startMin  Int
  endHour   Int
  endMin    Int

  // Break Time Configuration
  breakStartHour Int @default(12) 
  breakStartMin  Int @default(0)
  breakEndHour   Int @default(13)
  breakEndMin    Int @default(0)
  
  // Late Policy
  lateThresholdMin Int @default(15) 

  updatedAt DateTime @updatedAt

  @@map("work_configurations")
}

model SystemConfig {
  id                 Int       @id @default(autoincrement())
  year               Int       @unique
  isClosed           Boolean   @default(false)
  closedAt           DateTime?
  processedBy        Int?
  maxConsecutiveDays Int       @default(0)
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      Json     
  isSubsidy Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HolidayPolicy {
  id                        Int      @id @default(autoincrement())
  key                       String   @unique @db.VarChar(50) 
  workingDays               Json? 
  maxConsecutiveHolidayDays Int      @default(0)
  updatedBy                 Int?
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())
}

// ==========================================
// 4. Leave Management & Logs (ส่วนอื่นๆ เหมือนเดิม)
// ==========================================

model LeaveType {
  id                 Int     @id @default(autoincrement()) @map("leave_type_id")
  typeName           String  @unique @map("type_name") @db.VarChar(100)
  label              Json?   @map("label")
  isPaid             Boolean @default(true) @map("is_paid")
  maxCarryOver       Decimal @default(0.00) @map("max_carry_over") @db.Decimal(5, 2)
  maxConsecutiveDays Int?    @default(0) @map("max_consecutive_days")
  color              String  @default("#6366F1") @map("color") @db.VarChar(7)

  leaveQuotas        LeaveQuota[]
  leaveRequests      LeaveRequest[]
  specialLeaveGrants SpecialLeaveGrant[]

  @@map("leave_types")
}

model LeaveQuota {
  id            Int     @id @default(autoincrement()) @map("quota_id")
  employeeId    Int     @map("employee_id")
  leaveTypeId   Int     @map("leave_type_id")
  year          Int     @db.Year
  totalDays     Decimal @default(0.00) @map("total_days") @db.Decimal(5, 2)
  usedDays      Decimal @default(0.00) @map("used_days") @db.Decimal(5, 2)
  carryOverDays Decimal @default(0.00) @map("carry_over_days") @db.Decimal(5, 2)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_quotas")
}

model LeaveRequest {
  id                 Int           @id @default(autoincrement()) @map("request_id")
  employeeId         Int           @map("employee_id")
  leaveTypeId        Int           @map("leave_type_id")
  startDate          DateTime      @map("start_date") @db.Date
  endDate            DateTime      @map("end_date") @db.Date
  totalDaysRequested Decimal       @map("total_days_requested") @db.Decimal(4, 2)

  startDuration LeaveDuration @map("start_duration")
  endDuration   LeaveDuration @map("end_duration")

  reason          String?       @db.Text
  attachmentUrl   String?       @map("attachment_url") @db.VarChar(255)
  status          RequestStatus @map("status")
  rejectionReason String?       @map("rejection_reason") @db.Text
  cancelReason    String?       @map("cancel_reason") @db.Text
  requestedAt     DateTime      @default(now()) @map("requested_at")

  approvedByHrId Int?      @map("approved_by_hr_id")
  approvalDate   DateTime? @map("approval_date")

  specialGrantId Int? @map("special_grant_id")

  employee     Employee           @relation("EmployeeRequests", fields: [employeeId], references: [id])
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id])
  approvedByHr Employee?          @relation("HrApprovals", fields: [approvedByHrId], references: [id])
  specialGrant SpecialLeaveGrant? @relation(fields: [specialGrantId], references: [id])

  isSpecialApproved Boolean        @default(false) @map("is_special_approved")
  notifications     Notification[]

  @@index([employeeId, startDate])
  @@index([status])
  @@map("leave_requests")
}

model SpecialLeaveGrant {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  leaveTypeId Int      @map("leave_type_id")
  amount      Decimal  @db.Decimal(5, 2)
  reason      String   @db.VarChar(255)
  expiryDate  DateTime @map("expiry_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  employee      Employee       @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType      @relation(fields: [leaveTypeId], references: [id])
  leaveRequests LeaveRequest[]

  @@map("special_leave_grants")
}

model TimeRecord {
  id             Int             @id @default(autoincrement()) @map("record_id")
  employeeId     Int             @map("employee_id")
  workDate       DateTime        @map("work_date") @db.Date
  checkInTime    DateTime        @map("check_in_time")
  checkOutTime   DateTime?       @map("check_out_time")
  isLate         Boolean         @default(false) @map("is_late")
  note           String?         @db.Text
  checkInStatus  CheckInStatus?  @map("check_in_status")
  checkOutStatus CheckOutStatus? @map("check_out_status")
  checkInLat  Decimal? @map("check_in_lat") @db.Decimal(10, 8)
  checkInLng  Decimal? @map("check_in_lng") @db.Decimal(11, 8)
  checkOutLat Decimal? @map("check_out_lat") @db.Decimal(10, 8)
  checkOutLng Decimal? @map("check_out_lng") @db.Decimal(11, 8)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, workDate])
  @@map("time_records")
}

model AuditLog {
  id            Int         @id @default(autoincrement()) @map("log_id")
  action        AuditAction
  modelName     String      @map("model_name") @db.VarChar(100)
  recordId      Int         @map("record_id")
  performedById Int         @map("performed_by_id")
  performedBy   Employee    @relation("AuditLogsPerformedBy", fields: [performedById], references: [id])
  details   String?  @db.Text
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([modelName, recordId])
  @@index([performedById])
  @@map("audit_logs")
}

model Notification {
  id               Int              @id @default(autoincrement()) @map("notification_id")
  employeeId       Int              @map("employee_id")
  notificationType NotificationType @map("notification_type")
  message          String           @db.VarChar(500)
  relatedRequestId Int?             @map("related_request_id")
  relatedEmployeeId Int?      @map("related_employee_id")
  relatedEmployee   Employee? @relation("NotificationRelatedEmployee", fields: [relatedEmployeeId], references: [id])
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  employee Employee @relation("NotificationOwner", fields: [employeeId], references: [id])
  relatedRequest LeaveRequest? @relation(fields: [relatedRequestId], references: [id])

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([employeeId, isRead])
  @@index([relatedEmployeeId])
  @@map("notifications")
}